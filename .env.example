DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
CONGRESS_API_KEY=

# Base URL of this app, used by sync jobs to call the /revalidate endpoint after a
# sync so cached pages (home, bill detail) refresh. e.g. http://localhost:3000 in
# dev, or your deployed origin in production. If unset, revalidation is skipped.
APP_URL=http://localhost:3000
# Shared secret required by the /revalidate endpoint. Must match what sync jobs send.
REVALIDATE_SECRET=YOUR_REVALIDATE_SECRET_HERE
